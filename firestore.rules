rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /bloodRequests/{requestId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /donations/{donationId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /camps/{campId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /joinRequests/{reqId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.adminIds.hasAny([request.auth.uid]));
      allow create, update, delete: if false;
    }

    match /contactEvents/{eventId} {
      allow read: if signedIn() && resource.data.seekerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /contactLimits/{limitId} {
      allow read: if signedIn() && resource.data.seekerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
